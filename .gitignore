pubspec.lock
build/

# Placeholder art taken from the game this tool targets: local use only, never
# shared. The folder is kept (empty) so a fresh clone still builds; the home
# screen falls back to plain paper without the picture.
apps/pack_studio/assets/placeholder/*
!apps/pack_studio/assets/placeholder/.gitkeep

# kss16's events, offered as starting points in the editor (owner OK'd
# 2026-10-29), generated by d30mode-kss/tools/build_studio_events.py. Same rule
# as the art above: local use only, never committed or shipped. Without it the
# "Base-game events" button simply does not appear.
apps/pack_studio/assets/kss16_events/*
!apps/pack_studio/assets/kss16_events/.gitkeep

